# Signature images never go into an image: the same rules as .gitignore.
# `fly deploy` builds from the working tree, not from git, so a file that
# .gitignore keeps out of the repository would otherwise still be copied in
# (COPY skills-content in Dockerfile.worker, COPY . . in Dockerfile).
skills-content/**/signature.*
**/signature.png
**/signature.jpg
**/signature.jpeg
**/signatures

# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Neon Postgres ---
# Create a project at https://neon.tech. The app and the worker connect as a
# runtime role that row-level security applies to (not a superuser, no
# BYPASSRLS, owns no table); the owner role only runs migrations. Create the
# runtime role as README "Database roles" describes.

# The runtime role's *pooled* connection string. src/db/client.ts refuses to
# run tenant queries as a role RLS does not apply to.
DATABASE_URL="postgresql://app_runtime:password@host-pooler/dbname?sslmode=require"

# The owner role's connection string, for npm run db:migrate (and the
# worker's release command). Without it, migrations use DATABASE_URL.
MIGRATION_DATABASE_URL="postgresql://neondb_owner:password@host/dbname?sslmode=require"

# pg-boss (background job queue for skill runs) needs a plain Postgres-wire
# connection for its own schema/migrations and internal maintenance queries,
# which are not safe under Neon's pooled (PgBouncer transaction-mode)
# connection above. Use the runtime role's *direct* connection string
# (Dashboard > Connection Details > toggle off "Pooled connection").
QUEUE_DATABASE_URL="postgresql://app_runtime:password@host/dbname?sslmode=require"

# --- Clerk (auth + multi-tenancy via Organizations) ---
# Create an app at https://dashboard.clerk.com. Enable Organizations, keep
# Clerk's two default roles (Admin is the app's owner/admin; a Member's app
# role is set on the Firm page) and create no custom role (see
# src/lib/roles.ts), and turn "Allow user-created organizations" off: the
# app creates firms itself and gives the free month once per person
# (README "Clerk").
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# The secret key goes on the web app and on the worker: the worker reads a
# firm's owner/admin addresses from Clerk when it sends billing emails.
CLERK_SECRET_KEY="sk_test_..."
# Dashboard > Webhooks > add endpoint at <your-domain>/api/webhooks/clerk,
# subscribed to organization.* and organizationMembership.* events.
CLERK_WEBHOOK_SECRET="whsec_..."

# --- Billing (Stripe; README "Trial, billing and emails", DEPLOY.md) ---
# Every firm's first TRIAL_DAYS are free (kept in the app, not in Stripe);
# then $20 per user per month through Stripe Checkout on the Billing page.
# The account's secret key: sk_test_... while testing, sk_live_... for real
# payments. Web app (Checkout, the portal, the webhook) and worker (the
# daily job's seat sync and subscription refresh).
STRIPE_SECRET_KEY="sk_test_..."
# The per-user monthly Price, printed by `npm run stripe:setup` (which
# creates the Product "MeritDesk.AI" and the Price in that account). Make a
# new one when switching from test mode to live mode.
STRIPE_PRICE_ID="price_..."
# The signing secret of the webhook endpoint at <your-domain>/api/webhooks/stripe
# (Stripe dashboard > Developers > Webhooks). Web app only.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Days in every firm's free month (default 30), and days of full access
# after a failed payment before the firm is locked (default 7).
# TRIAL_DAYS="30"
# PAST_DUE_GRACE_DAYS="7"

# --- Emails (Amazon SES, sent by the worker) ---
# The sender of the app's emails to each firm's owner/admins (welcome, free
# month reminders, receipts, failed payments, renewals): an address on a
# domain verified in SES with DKIM (DEPLOY.md "Emails with SES"), optionally
# with a display name. Uses AWS_REGION and the AWS keys below. Unset: every
# email is logged and skipped, and nothing else is affected.
# SES_FROM_ADDRESS="MeritDesk.AI <no-reply@example.com>"

# --- Claude and ChatGPT connector (docs/CONNECTORS.md) ---
# The app's public origin, no path (the connector's server URL is this plus
# /api/mcp). Required in production: the OAuth metadata's resource must equal
# the URL members enter exactly, and without it the connector answers 500.
# In development, unset, the request's host is used. Also the origin of the
# links in the app's emails and of the Billing page the connector names to a
# locked firm (<origin>/billing), so set it on the worker too.
# CONNECTOR_PUBLIC_ORIGIN="https://app.example.com"
# The OAuth clients allowed to use the case-work tools (any client gets the
# library tools). Exact client ids, separated by commas or spaces, and https
# URL prefixes for Client ID Metadata Document clients (each must end in a
# slash after the host, e.g. "https://claude.ai/"). With neither set, case
# work is unavailable to every connection. The Firm page lists unrecognized
# client ids after a first test connection (docs/CONNECTORS.md section 3).
# CONNECTOR_ALLOWED_CLIENT_IDS=""
# CONNECTOR_ALLOWED_CLIENT_ID_PREFIXES=""
# The custom Clerk scope every connector token must carry (create it in
# Clerk, OAuth applications, Scopes, and add it to the default scopes for
# dynamic clients). Default practice:connector.
# CONNECTOR_REQUIRED_SCOPE="practice:connector"
# Skill runs one firm may queue through the connector per day (default 50).
# CONNECTOR_RUN_SKILL_DAILY_LIMIT="50"
# Per-IP limits on /api/mcp before authentication, per web machine
# (defaults 600 requests and 30 refused tokens a minute).
# CONNECTOR_IP_REQUESTS_PER_MINUTE="600"
# CONNECTOR_IP_AUTH_FAILURES_PER_MINUTE="30"
# When Cloudflare proxies the domain, the real caller address is in its
# CF-Connecting-IP header; "true" makes the per-IP limits use it. Set it only
# while every request reaches the app through Cloudflare (DEPLOY.md, "Your
# own domain, with Cloudflare in front").
# TRUST_CF_CONNECTING_IP="false"
# Clerk's OAuth issuer (its Frontend API URL, no trailing slash). Unset, it is
# decoded from NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY; set it only if that differs
# from the issuer in Clerk's /.well-known/oauth-authorization-server.
# CLERK_OAUTH_ISSUER=""

# --- AWS S3 (document storage) ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
S3_DOCUMENTS_BUCKET="..."

# --- Anthropic (Skill Runner) ---
# Use a Claude API key (console.anthropic.com), not a claude.ai consumer
# account. Apply for Zero Data Retention before real client PII flows
# through given the sensitivity of this data (see plan security section).
ANTHROPIC_API_KEY="sk-ant-..."

# --- Worker (optional) ---
# Seconds the worker waits for jobs in progress after SIGTERM/SIGINT before
# marking interrupted skill runs failed (1 to 280, default 90). Keep it below
# kill_timeout in fly.worker.toml.
# WORKER_SHUTDOWN_GRACE_SECONDS="90"

# --- Library (src/services/library/, docs/LIBRARY.md) ---
# The worker collects the library's official sources every day and walks
# their history in the background (politely paced: that takes days). Keep
# the history walk paused on a development machine; production leaves this
# unset, which means on.
LIBRARY_BACKFILL="paused"
# Pause the history walk of some sources only, or turn sources off entirely
# (comma-separated source codes, as /library and npm run library:probe list them).
# LIBRARY_BACKFILL_PAUSED_SOURCES=""
# LIBRARY_DISABLED_SOURCES=""
# Import from the official site (/library/import, docs/LIBRARY_SOURCES.md
# section 1). The platform operators allowed to import, as Clerk user ids
# (user_...), comma-separated; set it on the web app. Not a firm role: the
# library is shared by every firm, so an import changes what all of them read
# (README "The library"). Unset or empty, nobody can import.
# LIBRARY_IMPORT_ADMINS="user_..."
# The sources kept up to date by import instead of their daily run (their
# sites refuse automated tools). Unset: the 13 sources of
# docs/LIBRARY_SOURCES.md section 1; "none": no source; otherwise the
# comma-separated codes. Set the same value on the worker and the web app.
# LIBRARY_MANUAL_SOURCES=""
# Keep each fetched official file in S3 under library/ (public domain
# sources only). The IAM user then needs s3:PutObject and s3:GetObject on
# library/* too. LIBRARY_S3_BUCKET defaults to S3_DOCUMENTS_BUCKET.
# LIBRARY_STORE_ORIGINALS="true"
# LIBRARY_S3_BUCKET=""
# A contact (an email or URL of whoever runs this deployment) added to the
# collector's User-Agent, so a site's administrators can reach you.
# LIBRARY_USER_AGENT_CONTACT=""
# API keys some collectors need. A collector whose key is unset is skipped
# and shown on /library as "Needs API key"; send keys in request headers.
# COURTLISTENER_API_TOKEN=""   # CourtListener API (court opinions)
# API_DATA_GOV_KEY=""          # api.data.gov key: GovInfo and Regulations.gov
# CONGRESS_GOV_API_KEY=""      # api.congress.gov
# CourtListener's API allowance for this account, as the collectors count it
# (the free default; raise it for a membership).
# COURTLISTENER_API_LIMITS="5/minute,50/hour,125/day"
# EOIR court and judge statistics (src/services/library/adapters/eoir-statistics/):
# "paused" stops the daily check of EOIR's case data release and its load.
# EOIR_STATS_LOAD=""
